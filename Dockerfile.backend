FROM python:3.11-slim
WORKDIR /app
COPY requirements-backend.txt .
RUN pip install --no-cache-dir -r requirements-backend.txt
COPY app.py superkart_model.joblib ./
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD python -c "import requests; requests.get('http://localhost:7860/health',timeout=3).raise_for_status()"
CMD ["gunicorn","--bind","0.0.0.0:7860","app:superkart_api"]
